	depends = glib2
	depends = cairo
	depends = pango
	depends = gdk-pixbuf2
	depends = libsoup3
	depends = libayatana-appindicator
	depends = libnotify
	depends = librsvg
	depends = hicolor-icon-theme
	depends = desktop-file-utils
	depends = xdg-utils
