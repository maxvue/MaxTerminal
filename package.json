{
  "name": "maxterminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "maxLocalLibs": {
    "@maxvue/max-components-ui": "MaxComponentsUi",
    "@maxvue/max-use": "MaxUse",
    "@maxvue/max-pinia": "MaxPinia"
  },
  "scripts": {
    "dev": "bash .vscode/run-dev.sh",
    "dev:vite": "node scripts/run-vite.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "tauri": "tauri",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.node.json && tsgo --noEmit -p tsconfig.test.json",
    "typecheck:vue": "vue-tsc --noEmit -p tsconfig.vue.json",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "lint:style": "stylelint --allow-empty-input \"src/**/*.{scss,vue}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "sync:local-libs": "node scripts/sync-local-libs.mjs",
    "bindings": "cargo test --manifest-path src-tauri/Cargo.toml --locked --test bindings export -- --ignored --exact",
    "bench:search": "cargo bench --manifest-path src-tauri/Cargo.toml -p mt-db --bench search",
    "bench:system": "node scripts/bench/report.mjs",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs --smoke",
    "check:traceability": "node scripts/check-traceability.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.5.0",
    "@vueuse/core": "14.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "1.7.9",
    "pinia": "3.0.1",
    "splitpanes": "4.1.2",
    "vue": "3.6.0-rc.13",
    "vue-router": "4.5.0",
    "vue-web-terminal": "^3.4.2"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "4.2.0",
    "@tauri-apps/cli": "2.5.0",
    "@types/node": "22.14.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.24.0",
    "eslint-plugin-vue": "10.0.0",
    "globals": "16.0.0",
    "happy-dom": "17.4.4",
    "postcss-html": "1.8.0",
    "postcss-scss": "4.0.9",
    "sass-embedded": "1.86.3",
    "stylelint": "16.18.0",
    "stylelint-config-recommended-vue": "1.6.0",
    "stylelint-config-standard-scss": "14.0.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.29.1",
    "unocss": "66.10.5",
    "vite": "8.0.0",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.1.3",
    "vue-tsc": "2.2.8"
  },
  "overrides": {
    "vue": "3.6.0-rc.13"
  }
}
